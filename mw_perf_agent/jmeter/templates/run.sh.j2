#!/usr/bin/env bash
# Auto-generated by MW Perf-Agent (run_id={{ run_id }})
# Usage: ./run.sh [extra jmeter args, e.g. -Jstep1.threads=40]
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
JMETER="${JMETER_HOME:-/opt/apache-jmeter}/bin/jmeter"
if ! [ -x "$JMETER" ]; then JMETER="$(command -v jmeter || true)"; fi
if [ -z "$JMETER" ]; then echo "jmeter not found. Set JMETER_HOME." >&2; exit 1; fi
OUT="$HERE/out_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$OUT"
"$JMETER" -n -t "$HERE/plan.jmx" -q "$HERE/user.properties" \
  -l "$OUT/result.jtl" -j "$OUT/jmeter.log" -e -o "$OUT/report" \
  -Jjmeter.save.saveservice.output_format=csv \
  -Jjmeter.save.saveservice.timestamp_format=ms \
  -Jsummariser.interval={{ summariser_interval }} "$@"
echo "JTL: $OUT/result.jtl  (upload this file in Tab 4 for analysis)"
