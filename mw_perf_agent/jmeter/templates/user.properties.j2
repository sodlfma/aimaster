# Auto-generated by MW Perf-Agent (run_id={{ run_id }})
# Override any value with -Jkey=value, e.g. jmeter -n -t plan.jmx -q user.properties -Jstep4.threads=400
target.protocol={{ scenario.protocol }}
target.host={{ scenario.host }}
target.port={{ scenario.port }}
target.connect_timeout=5000
target.response_timeout=30000
target.think_time={{ scenario.think_time_ms }}
{% for step in plan.steps %}
# {{ step.name }} — expected: {{ step.expected_symptom }}
step{{ loop.index }}.threads={{ step.target_concurrency }}
step{{ loop.index }}.rampup={{ step.ramp_up_sec }}
step{{ loop.index }}.duration={{ step.ramp_up_sec + step.hold_sec }}
{% endfor %}
# JTL output format required by the post-analysis step
jmeter.save.saveservice.output_format=csv
jmeter.save.saveservice.timestamp_format=ms
jmeter.save.saveservice.thread_counts=true
jmeter.save.saveservice.latency=true
jmeter.save.saveservice.connect_time=true
jmeter.save.saveservice.response_code=true
jmeter.save.saveservice.response_message=true
jmeter.save.saveservice.assertion_results_failure_message=true
jmeter.save.saveservice.successful=true
jmeter.save.saveservice.label=true
jmeter.save.saveservice.thread_name=true
summariser.interval={{ summariser_interval }}
