##############################################
export CATALINA_HOME="/software/tomcat"
export CATALINA_BASE="$CATALINA_HOME/servers/$SERVER_NAME"
export CATALINA_OPTS="-Denv=product -Denv.servername=$SERVER_NAME -Djava.security.egd=file:/dev/./urandom"
