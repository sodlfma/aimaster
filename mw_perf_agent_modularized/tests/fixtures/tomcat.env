#!/bin/sh
# 사내 표준 Tomcat 인스턴스 환경 (shl/tomcat.env)
export CATALINA_HOME=/sw/tomcat
export CATALINA_BASE=/sw/was/inst01
JAVA_OPTS="$JAVA_OPTS -server -Xms1024m -Xmx2g"
JAVA_OPTS="$JAVA_OPTS -XX:+UseG1GC -XX:MaxGCPauseMillis=200"
JAVA_OPTS="$JAVA_OPTS -Dtomcat.connector.port=8080"
JAVA_OPTS="$JAVA_OPTS -Dtomcat.connector.maxThreads=200"
JAVA_OPTS="$JAVA_OPTS -Dtomcat.connector.acceptCount=100"
JAVA_OPTS="$JAVA_OPTS -Ddbcp.maxTotal=50 -Ddbcp.maxWaitMillis=10000"
